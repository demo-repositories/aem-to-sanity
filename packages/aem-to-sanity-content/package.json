{
  "name": "aem-to-sanity-content",
  "version": "0.0.0",
  "description": "Migrate AEM content (via .infinity.json) into Sanity documents, with drift audit.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "migrate:content": "node dist/cli.js"
  },
  "bin": {
    "aem-to-sanity-content": "./dist/cli.js"
  },
  "dependencies": {
    "aem-to-sanity-core": "workspace:*",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@sanity/client": "^7.21.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@sanity/client": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@sanity/client": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
