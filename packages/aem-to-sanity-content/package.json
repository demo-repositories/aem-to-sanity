{
  "name": "aem-to-sanity-content",
  "version": "1.11.0",
  "description": "Three flat scripts to migrate AEM content (.infinity.json) into Sanity: extract → transform → import.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demo-repositories/aem-to-sanity.git",
    "directory": "packages/aem-to-sanity-content"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf dist .turbo",
    "probe:media-library": "tsx ../../scripts/probe-media-library.ts"
  },
  "bin": {
    "aem-extract": "./dist/extract.js",
    "aem-tags": "./dist/tags.js",
    "aem-transform": "./dist/transform.js",
    "aem-assets": "./dist/assets.js",
    "aem-import": "./dist/import.js"
  },
  "dependencies": {
    "@portabletext/block-tools": "^5.1.12",
    "@portabletext/schema": "^2.2.3",
    "@types/jsdom": "^28.0.3",
    "aem-to-sanity-core": "workspace:*",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@sanity/client": "^7.24.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@sanity/client": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@sanity/client": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
