{
  "name": "@shehjad/create-aem-to-sanity",
  "version": "0.2.0",
  "description": "Scaffold a new AEM → Sanity migration project: a standalone config + Studio project with the toolkit installed from npm (or --clone for the full monorepo).",
  "dependencies": {
    "aem-to-sanity-cli": "workspace:^"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-aem-to-sanity": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demo-repositories/aem-to-sanity.git",
    "directory": "packages/create-aem-to-sanity"
  }
}
