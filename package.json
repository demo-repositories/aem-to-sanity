{
  "name": "aem-to-sanity-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for AEM → Sanity migration tooling (schema generator + content migrator).",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "prepare": "tsx scripts/ensure-studio-stub.ts",
    "migrate:schema": "turbo run migrate:schema",
    "migrate:content": "turbo run migrate:content",
    "migrate:init": "tsx scripts/migrate-init.ts",
    "studio:init": "tsx scripts/studio-init.ts",
    "studio:sync": "tsx scripts/studio-sync.ts",
    "toolkit:update": "tsx scripts/toolkit-update.ts",
    "migrate:doctor": "tsx scripts/migrate-doctor.ts",
    "build:demo-fixtures": "tsx scripts/build-demo-fixtures.ts",
    "typegen": "turbo run typegen",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^25.6.0",
    "gifenc": "^1.0.3",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.9.3"
    }
  }
}
